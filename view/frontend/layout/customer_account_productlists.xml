<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument translate="true" name="title" xsi:type="string">My lists</argument>
            </action>
        </referenceBlock>
        <referenceBlock name="customer_account_navigation">
            <action method="setActive">
                <argument name="path" xsi:type="string">customer/account/productlists</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block
                class="BroSolutions\QuickOrder\Block\Customer\ProductLists"
                   name="brosolutions_productlists"
                   cacheable="false"
                   template="BroSolutions_QuickOrder::customer/product_lists.phtml">
            <arguments>
                <argument name="view_model" xsi:type="object">Magento\OrderCancellationUi\ViewModel\Config</argument>
            </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
