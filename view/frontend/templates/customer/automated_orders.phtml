declare(strict_types=1);

use BroSolutions\QuickOrder\Block\Customer\AutomatedOrders;
use BroSolutions\QuickOrder\Model\ResourceModel\AutomaticSchedule;
use Magento\Framework\Escaper;

/**
 * @var AutomatedOrders $block
 * @var Escaper $escaper
 **/

$orders = $block->getOrders();
?>

<div class="block">
    <div class="block-content">
        <?php if ($orders->getSize()): ?>
            <div class="overflow-x-auto card mb-4">
                <table class="data table w-full sm:table-fixed lg:table-auto">
                    <thead class="table-header-top text-sm whitespace-nowrap">
                    <tr>
                        <th class="p-2 text-start"><?= $escaper->escapeHtml(__('List Name')); ?></th>
                        <th class="p-2 text-start"><?= $escaper->escapeHtml(__('Frequency')); ?></th>
                        <th class="p-2 text-start"><?= $escaper->escapeHtml(__('Start at')); ?></th>
                        <th class="p-2 text-start"><?= $escaper->escapeHtml(__('Timezone')); ?></th>
                        <th class="p-2 text-start"><?= $escaper->escapeHtml(__('Next run at')); ?></th>
                        <th class="p-2 text-start"><?= $escaper->escapeHtml(__('Last run at')); ?></th>
                        <th class="p-2 text-start"><?= $escaper->escapeHtml(__('Status')); ?></th>
                        <th class="p-2 text-start"><?= $escaper->escapeHtml(__('Created At')); ?></th>
                        <th class="p-2 text-start"><?= $escaper->escapeHtml(__('Action')); ?></th>
                    </tr>
                    </thead>
                    <tbody class="text-sm whitespace-nowrap">
                    <?php foreach ($orders as $order): ?>
                        <tr class="border-b last:border-0 align-top">
                            <td class="p-2">
                                <a href="<?= $escaper->escapeUrl($block->getUrl('customer/account/productlistview/list_id/' . $order->getListId())); ?>" class="hover:underline text-primary font-medium">
                                    <?= $escaper->escapeHtml($order->getListName()); ?>
                                </a>
                            </td>
                            <td class="p-2">
                                <?php
                                $freqCode = (string)$order->getFrequency();
                                if ($freqCode === 'monthly_n') {
                                    echo $escaper->escapeHtml((string)__('Every %1 months', $order->getFrequencyValue()));
                                } else {
                                    echo $escaper->escapeHtml($block->getFrequencyLabel($freqCode));
                                }
                                ?>
                            </td>
                            <td class="p-2"><?= $escaper->escapeHtml($block->formatScheduleDate((string)$order->getStartAt(), (string)$order->getTimezone())); ?></td>
                            <td class="p-2"><?= $escaper->escapeHtml((string)$order->getTimezone()); ?></td>
                            <td class="p-2"><?= $escaper->escapeHtml($block->formatScheduleDate((string)$order->getNextRunAt(), (string)$order->getTimezone())); ?></td>

                            <td class="p-2"><?= $order->getLastRunAt() ? $escaper->escapeHtml($block->formatScheduleDate((string)$order->getLastRunAt(), (string)$order->getTimezone())) : $escaper->escapeHtml(__('Never')); ?></td>

                            <td class="p-2">
                                <?php
                                $statusClass = 'text-gray-600';
                                if ($order->getStatus() === AutomaticSchedule::STATUS_ACTIVE) {
                                    $statusClass = 'text-green-600 font-medium';
                                } elseif ($order->getStatus() === AutomaticSchedule::STATUS_PAUSED) {
                                    $statusClass = 'text-orange-500 font-medium';
                                } elseif ($order->getStatus() === AutomaticSchedule::STATUS_ERROR) {
                                    $statusClass = 'text-red-600 font-medium';
                                }
                                ?>

                                <span class="<?= $escaper->escapeHtmlAttr($statusClass) ?>">
                                    <?= $escaper->escapeHtml(ucfirst((string)$order->getStatus())); ?>
                                </span>
                            </td>
                            <td class="p-2"><?= $escaper->escapeHtml($block->formatScheduleDate((string)$order->getCreatedAt(), (string)$order->getTimezone())); ?></td>
                            <td class="p-2">
                                <a href="<?= $escaper->escapeUrl($block->getUrl('customer/account/scheduleview/schedule_id/' . $order->getScheduleId())); ?>" class="action view text-sm font-medium hover:underline text-primary">
                                    <span><?= $escaper->escapeHtml(__('View')); ?></span>
                                </a>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        <?php else: ?>
            <div class="message info empty mb-6">
                <span><?= $escaper->escapeHtml(__('No automated orders found.')) ?></span>
            </div>
        <?php endif; ?>
    </div>

    <div class="actions-toolbar mt-6 flex justify-start text-left automated-orders-actions">
        <div class="primary">
            <a href="<?= $escaper->escapeUrl($block->getUrl('customer/account/createschedule')) ?>" class="action primary btn btn-primary">
                <span><?= $escaper->escapeHtml(__('Create Automated Order')) ?></span>
            </a>
        </div>
    </div>
</div>
