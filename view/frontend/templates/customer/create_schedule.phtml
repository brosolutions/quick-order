<script>
    const freq = document.getElementById('frequency');
    const wrapper = document.getElementById('frequency_value_wrapper');
    const startInput = document.getElementById('start-at');
    const preview = document.getElementById('next-run-preview');
    const intervalInput = document.getElementById('frequency_value');

    const actionPrice = document.getElementById('action_price');
    const priceThresholdWrapper = document.getElementById('price_threshold_wrapper');
    const priceThresholdInput = document.getElementById('price_threshold');

    function calculatePreview() {
        if (!startInput.value) return;

        let date = new Date(startInput.value);
        let frequency = freq.value;

        if (frequency === 'monthly') {
            date.setMonth(date.getMonth() + 1);
        } else if (frequency === 'monthly_n') {
            let n = parseInt(intervalInput.value) || 1;
            date.setMonth(date.getMonth() + n);
        } else if (frequency === 'weekly') {
            date.setDate(date.getDate() + 7);
        }

        preview.innerText = date.toLocaleString();
    }

    freq.addEventListener('change', () => {
        wrapper.style.display = freq.value === 'monthly_n' ? 'block' : 'none';
        if (freq.value !== 'monthly_n') {
            intervalInput.classList.remove('required-entry');
        } else {
            intervalInput.classList.add('required-entry');
        }
        calculatePreview();
    });

    if (actionPrice) {
        actionPrice.addEventListener('change', function(e) {
            if (e.target.value === 'block') {
                priceThresholdWrapper.style.display = 'block';
                priceThresholdInput.classList.add('required-entry');
            } else {
                priceThresholdWrapper.style.display = 'none';
                priceThresholdInput.classList.remove('required-entry');
            }
        });
    }

    startInput.addEventListener('change', calculatePreview);
    intervalInput.addEventListener('input', calculatePreview);

    calculatePreview();
</script>
