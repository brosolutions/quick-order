declare(strict_types=1);

use BroSolutions\QuickOrder\Block\Item\Renderer\GroupedRenderer;
use Magento\Framework\Escaper;

/**
 * @var GroupedRenderer $block
 * @var Escaper $escaper
 **/

$_childItems = $block->getItem()->getChildItems();
$_childItemsQty = $block->getItem()->getChildItemsQty();
?>

<?php foreach ($_childItems as $childItem): ?>
    <tr>
        <?php if ($childItem->getIsNotAvailable()): ?>
            <td class="col name p-2 text-start font-normal" data-th="<?= $escaper->escapeHtml(__('Product Name')) ?>">
                <span class="error-message"> <?= $escaper->escapeHtml(__($childItem->getErrorMessage())) ?></span>
            </td>
        <?php else: ?>
            <td class="col name p-2 text-start font-normal" data-th="<?= $escaper->escapeHtml(__('Product Name')) ?>">
                <span class="product name "><?= $escaper->escapeHtml($childItem->getName()) ?></span>
            </td>
        <?php endif; ?>
        <td class="col sku p-2 text-start font-normal" data-th="<?= $escaper->escapeHtml(__('SKU')) ?>">
            <span><?= $escaper->escapeHtml($block->prepareSku($childItem->getSku())) ?></span>
        </td>
        <?php if ($childItem->getIsNotAvailable()): ?>
            <td class="col price p-2 text-start font-normal" data-th="<?= $escaper->escapeHtml(__('Price')) ?>">
            </td>
        <?php else: ?>
            <td class="col price p-2 text-start font-normal" data-th="<?= $escaper->escapeHtml(__('Price')) ?>">
                <span> <?= $escaper->escapeHtml($block->getChildItemPriceHtml($childItem->getProduct())) ?></span>
            </td>
        <?php endif; ?>
        <td class="col qty p-2 text-start font-normal" data-th="<?= $escaper->escapeHtml(__('Qty')) ?>">
            <span><?= $escaper->escapeHtml($childItem->getQty()) ?></span>
        </td>
        <?php if ($childItem->getIsNotAvailable()): ?>
            <td class="col subtotal p-2 text-start font-normal" data-th="<?= $escaper->escapeHtml(__('Subtotal')) ?>">
            </td>
        <?php else: ?>
            <td class="col subtotal p-2 text-start font-normal" data-th="<?= $escaper->escapeHtml(__('Subtotal')) ?>">
                <span><?= $escaper->escapeHtml($block->getChildItemRowTotalHtml($childItem->getProduct(), $_childItemsQty)) ?></span>
            </td>
        <?php endif; ?>
        <td class="col actions p-2 text-center font-normal">
            <?php if (!$childItem->getIsNotAvailable()): ?>
                <a href="#" class="action-price-history inline-block cursor-pointer text-gray-500 hover:text-primary"
                   data-sku="<?= $escaper->escapeHtmlAttr($block->getItem()->getSku()) ?>"
                   title="<?= $escaper->escapeHtmlAttr(__('View Price History')) ?>">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                    </svg>
                </a>
            <?php endif; ?>
        </td>
    </tr>
<?php endforeach; ?>
