<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">quickorder_schedule_form.quickorder_schedule_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Schedule Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="save" class="BroSolutions\QuickOrder\Block\Adminhtml\Schedule\Edit\SaveButton"/>
            <button name="delete" class="BroSolutions\QuickOrder\Block\Adminhtml\Schedule\Edit\DeleteButton"/>
            <button name="back" class="BroSolutions\QuickOrder\Block\Adminhtml\Schedule\Edit\BackButton"/>
        </buttons>
        <namespace>quickorder_schedule_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>quickorder_schedule_form.quickorder_schedule_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="quickorder_schedule_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="quickorder_admin/schedule/save"/>
        </settings>
        <dataProvider class="BroSolutions\QuickOrder\Model\AutomaticSchedule\DataProvider" name="quickorder_schedule_form_data_source">
            <settings>
                <requestFieldName>schedule_id</requestFieldName>
                <primaryFieldName>schedule_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">Schedule Status</label>
        </settings>

        <field name="schedule_id" formElement="hidden">
            <settings>
                <dataType>text</dataType>
            </settings>
        </field>

        <field name="status" formElement="select" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Status</label>
                <dataScope>status</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="BroSolutions\QuickOrder\Model\ResourceModel\AutomaticSchedule\Source\Status"/>
                        <caption translate="true">-- Please Select --</caption>
                    </settings>
                </select>
            </formElements>
        </field>

        <field name="list_id" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">List ID</label>
                <dataScope>list_id</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>

        <field name="frequency" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Frequency</label>
                <dataScope>frequency</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>

        <field name="next_run_at" formElement="input" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Next Run At (UTC)</label>
                <dataScope>next_run_at</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>
    </fieldset>
    <fieldset name="execution_logs" sortOrder="50">
        <settings>
            <label translate="true">Execution Logs</label>
        </settings>
        <container name="logs_container">
            <htmlContent name="html_content">
                <block class="BroSolutions\QuickOrder\Block\Adminhtml\Schedule\Edit\Logs" name="schedule.logs.view" template="BroSolutions_QuickOrder::schedule/logs.phtml"/>
            </htmlContent>
        </container>
    </fieldset>
</form>
