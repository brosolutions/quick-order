<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="brosolutions_quickorder_list" resource="default" engine="innodb" comment="BroSolutions Lists">
        <column xsi:type="bigint" name="id" unsigned="true" nullable="false" identity="true" comment="List ID"/>
        <column xsi:type="varchar" name="list_name" length="255" nullable="false" comment="List Name"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store ID"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="id"/></constraint>
        <constraint xsi:type="foreign" referenceId="FK_BROSOLUTIONS_LIST_CUSTOMER" table="brosolutions_quickorder_list" column="customer_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="FK_BROSOLUTIONS_LIST_STORE" table="brosolutions_quickorder_list" column="store_id" referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
        <index referenceId="IDX_BROSOLUTIONS_LIST_CUSTOMER"><column name="customer_id"/></index>
        <index referenceId="IDX_BROSOLUTIONS_LIST_STORE"><column name="store_id"/></index>
        <index referenceId="IDX_BROSOLUTIONS_LIST_NAME"><column name="list_name"/></index>
    </table>

    <table name="brosolutions_quickorder_list_item" resource="default" engine="innodb" comment="BroSolutions Product List Items">
        <column xsi:type="bigint" name="id" unsigned="true" nullable="false" identity="true" comment="Item ID"/>
        <column xsi:type="bigint" name="list_id" unsigned="true" nullable="false" comment="List ID"/>
        <column xsi:type="bigint" name="product_id" unsigned="true" nullable="false" comment="Product ID"/>
        <column xsi:type="varchar" name="sku" length="64" nullable="false" comment="Product SKU"/>
        <column xsi:type="bigint" name="parent_id" unsigned="true" nullable="true" comment="Parent Item ID"/>
        <column xsi:type="decimal" name="qty" precision="12" scale="4" nullable="false" default="1.0000" comment="Product Quantity"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="id"/></constraint>
        <constraint xsi:type="foreign" referenceId="FK_BROSOLUTIONS_PRODUCT_LIST_LIST" table="brosolutions_quickorder_list_item" column="list_id" referenceTable="brosolutions_quickorder_list" referenceColumn="id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="FK_BROSOLUTIONS_PRODUCT_LIST_PARENT" table="brosolutions_quickorder_list_item" column="parent_id" referenceTable="brosolutions_quickorder_list_item" referenceColumn="id" onDelete="CASCADE"/>
        <index referenceId="IDX_BROSOLUTIONS_PRODUCT_LIST_LIST"><column name="list_id"/></index>
        <index referenceId="IDX_BROSOLUTIONS_PRODUCT_LIST_PRODUCT"><column name="product_id"/></index>
        <index referenceId="IDX_BROSOLUTIONS_PRODUCT_LIST_PARENT"><column name="parent_id"/></index>
        <index referenceId="IDX_BROSOLUTIONS_PRODUCT_LIST_SKU"><column name="sku"/></index>
    </table>

    <table name="brosolutions_quickorder_schedule" resource="default" engine="innodb" comment="QuickOrder Automatic Schedules">
        <column xsi:type="bigint" name="schedule_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="bigint" name="list_id" unsigned="true" nullable="false"/>
        <column xsi:type="text" name="shipping_address" nullable="false"/>
        <column xsi:type="text" name="billing_address" nullable="false"/>
        <column xsi:type="varchar" name="shipping_method" length="255" nullable="false"/>
        <column xsi:type="varchar" name="payment_method" length="255" nullable="false"/>
        <column xsi:type="varchar" name="frequency" length="32" nullable="false" comment="monthly|monthly_n|weekly"/>
        <column xsi:type="int" name="frequency_value" nullable="true" comment="N for monthly_n"/>
        <column xsi:type="timestamp" name="start_at" nullable="false"/>
        <column xsi:type="varchar" name="timezone" length="64" nullable="false"/>
        <column xsi:type="timestamp" name="next_run_at" nullable="false"/>
        <column xsi:type="timestamp" name="last_run_at" nullable="true"/>
        <column xsi:type="varchar" name="status" length="16" nullable="false" default="active"/>

        <column xsi:type="int" name="last_order_id" unsigned="true" nullable="true" comment="Last Created Order ID"/>
        <column xsi:type="varchar" name="action_missing" length="32" nullable="false" default="error" comment="Action if product missing or disabled"/>
        <column xsi:type="varchar" name="action_oos" length="32" nullable="false" default="error" comment="Action if out of stock"/>
        <column xsi:type="varchar" name="action_price" length="32" nullable="false" default="allow" comment="Action if price changed"/>
        <column xsi:type="decimal" name="price_threshold" scale="2" precision="12" nullable="true" comment="Price change percentage threshold"/>
        <column xsi:type="text" name="original_prices" nullable="true" comment="JSON map of SKUs and their prices at schedule creation"/>

        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="schedule_id"/></constraint>
        <constraint xsi:type="foreign" referenceId="FK_QO_SCHEDULE_LIST" referenceTable="brosolutions_quickorder_list" referenceColumn="id" column="list_id" onDelete="CASCADE"/>
        <index referenceId="IDX_QO_SCHEDULE_NEXT_RUN"><column name="next_run_at"/></index>
    </table>

    <table name="brosolutions_quickorder_schedule_log" resource="default" engine="innodb" comment="QuickOrder Schedule Execution History">
        <column xsi:type="bigint" name="log_id" unsigned="true" nullable="false" identity="true" comment="Log ID"/>
        <column xsi:type="bigint" name="schedule_id" unsigned="true" nullable="false" comment="Schedule ID"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="true" comment="Created Order ID"/>
        <column xsi:type="varchar" name="status" length="16" nullable="false" comment="success|error"/>
        <column xsi:type="text" name="message" nullable="true" comment="Error or Success message"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Execution Time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="log_id"/></constraint>
        <constraint xsi:type="foreign" referenceId="FK_QO_LOG_SCHEDULE_ID" table="brosolutions_quickorder_schedule_log" column="schedule_id" referenceTable="brosolutions_quickorder_schedule" referenceColumn="schedule_id" onDelete="CASCADE"/>
    </table>

    <table name="brosolutions_quickorder_price_history" resource="default" engine="innodb" comment="QuickOrder Price History">
        <column xsi:type="bigint" name="history_id" unsigned="true" nullable="false" identity="true" comment="History ID"/>
        <column xsi:type="bigint" name="schedule_id" unsigned="true" nullable="false" comment="Schedule ID"/>
        <column xsi:type="varchar" name="sku" length="64" nullable="false" comment="Product SKU"/>
        <column xsi:type="decimal" name="old_price" precision="12" scale="4" nullable="false" comment="Old Price"/>
        <column xsi:type="decimal" name="new_price" precision="12" scale="4" nullable="false" comment="New Price"/>
        <column xsi:type="timestamp" name="changed_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Change Date"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="history_id"/></constraint>
        <constraint xsi:type="foreign" referenceId="FK_QO_PRICE_HIST_SCHED" table="brosolutions_quickorder_price_history" column="schedule_id" referenceTable="brosolutions_quickorder_schedule" referenceColumn="schedule_id" onDelete="CASCADE"/>
        <index referenceId="IDX_QO_PRICE_HIST_SKU"><column name="sku"/></index>
    </table>
</schema>
