<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="brosolutions_quickorder_list"
           resource="default"
           engine="innodb"
           comment="BroSolutions Lists">

        <column xsi:type="bigint" name="id" unsigned="true"
                nullable="false" identity="true" comment="List ID"/>

        <column xsi:type="varchar" name="list_name" length="255"
                nullable="false" comment="List Name"/>

        <column xsi:type="int" name="customer_id" unsigned="true"
                nullable="false" comment="Customer ID"/>

        <column xsi:type="smallint" name="store_id" unsigned="true"
                nullable="false" comment="Store ID"/>

        <column xsi:type="timestamp" name="created_at"
                nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created At"/>

        <column xsi:type="timestamp" name="updated_at"
                nullable="false" default="CURRENT_TIMESTAMP"
                on_update="true" comment="Updated At"/>

        <!-- Primary -->
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>

        <!-- FK to customer -->
        <constraint xsi:type="foreign"
                    referenceId="FK_BROSOLUTIONS_LIST_CUSTOMER"
                    table="brosolutions_quickorder_list"
                    column="customer_id"
                    referenceTable="customer_entity"
                    referenceColumn="entity_id"
                    onDelete="CASCADE"/>

        <!-- FK to store -->
        <constraint xsi:type="foreign"
                    referenceId="FK_BROSOLUTIONS_LIST_STORE"
                    table="brosolutions_quickorder_list"
                    column="store_id"
                    referenceTable="store"
                    referenceColumn="store_id"
                    onDelete="CASCADE"/>

        <!-- Indexes -->
        <index referenceId="IDX_BROSOLUTIONS_LIST_CUSTOMER">
            <column name="customer_id"/>
        </index>

        <index referenceId="IDX_BROSOLUTIONS_LIST_STORE">
            <column name="store_id"/>
        </index>

        <index referenceId="IDX_BROSOLUTIONS_LIST_NAME">
            <column name="list_name"/>
        </index>

    </table>


    <table name="brosolutions_quickorder_list_item"
           resource="default"
           engine="innodb"
           comment="BroSolutions Product List Items">

        <column xsi:type="bigint" name="id" unsigned="true"
                nullable="false" identity="true" comment="Item ID"/>

        <column xsi:type="bigint" name="list_id" unsigned="true"
                nullable="false" comment="List ID"/>

        <column xsi:type="bigint" name="product_id" unsigned="true"
                nullable="false" comment="Product ID"/>

        <column xsi:type="varchar" name="sku" length="64"
                nullable="false" comment="Product SKU"/>

        <!-- Self reference -->
        <column xsi:type="bigint" name="parent_id" unsigned="true"
                nullable="true" comment="Parent Item ID"/>

        <column xsi:type="decimal" name="qty" precision="12" scale="4"
                nullable="false" default="1.0000"
                comment="Product Quantity"/>

        <column xsi:type="timestamp" name="created_at"
                nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created At"/>

        <column xsi:type="timestamp" name="updated_at"
                nullable="false" default="CURRENT_TIMESTAMP"
                on_update="true" comment="Updated At"/>

        <!-- Primary -->
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>

        <!-- FK to list -->
        <constraint xsi:type="foreign"
                    referenceId="FK_BROSOLUTIONS_PRODUCT_LIST_LIST"
                    table="brosolutions_quickorder_list_item"
                    column="list_id"
                    referenceTable="brosolutions_quickorder_list"
                    referenceColumn="id"
                    onDelete="CASCADE"/>

        <!-- Self FK -->
        <constraint xsi:type="foreign"
                    referenceId="FK_BROSOLUTIONS_PRODUCT_LIST_PARENT"
                    table="brosolutions_quickorder_list_item"
                    column="parent_id"
                    referenceTable="brosolutions_quickorder_list_item"
                    referenceColumn="id"
                    onDelete="CASCADE"/>

        <!-- Indexes -->
        <index referenceId="IDX_BROSOLUTIONS_PRODUCT_LIST_LIST">
            <column name="list_id"/>
        </index>

        <index referenceId="IDX_BROSOLUTIONS_PRODUCT_LIST_PRODUCT">
            <column name="product_id"/>
        </index>

        <index referenceId="IDX_BROSOLUTIONS_PRODUCT_LIST_PARENT">
            <column name="parent_id"/>
        </index>

        <index referenceId="IDX_BROSOLUTIONS_PRODUCT_LIST_SKU">
            <column name="sku"/>
        </index>

    </table>

    <table name="brosolutions_quickorder_schedule"
           resource="default"
           engine="innodb"
           comment="QuickOrder Automatic Schedules">

        <column xsi:type="bigint" name="schedule_id" unsigned="true"
                nullable="false" identity="true"/>

        <!-- Related QuickOrder list -->
        <column xsi:type="bigint" name="list_id" unsigned="true" nullable="false"/>

        <!-- Snapshot data -->
        <column xsi:type="text" name="shipping_address" nullable="false"/>
        <column xsi:type="text" name="billing_address" nullable="false"/>
        <column xsi:type="varchar" name="shipping_method" length="255" nullable="false"/>
        <column xsi:type="varchar" name="payment_method" length="255" nullable="false"/>

        <!-- Schedule config -->
        <column xsi:type="varchar" name="frequency" length="32" nullable="false"
                comment="monthly|monthly_n|weekly"/>
        <column xsi:type="int" name="frequency_value" nullable="true"
                comment="N for monthly_n"/>
        <column xsi:type="timestamp" name="start_at" nullable="false"/>
        <column xsi:type="varchar" name="timezone" length="64" nullable="false"/>

        <!-- Runtime -->
        <column xsi:type="timestamp" name="next_run_at" nullable="false"/>
        <column xsi:type="timestamp" name="last_run_at" nullable="true"/>

        <!-- Status -->
        <column xsi:type="varchar" name="status" length="16" nullable="false"
                default="active"/>

        <column xsi:type="timestamp" name="created_at"
                nullable="false" default="CURRENT_TIMESTAMP"/>
        <column xsi:type="timestamp" name="updated_at"
                nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>

        <!-- Primary Key -->
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="schedule_id"/>
        </constraint>

        <constraint xsi:type="foreign"
                    referenceId="FK_QO_SCHEDULE_LIST"
                    referenceTable="brosolutions_quickorder_list"
                    referenceColumn="id"
                    column="list_id"
                    onDelete="CASCADE"/>

        <index referenceId="IDX_QO_SCHEDULE_NEXT_RUN">
            <column name="next_run_at"/>
        </index>
    </table>

</schema>
