<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="brosolutions_list"
           resource="default"
           engine="innodb"
           comment="BroSolutions Lists">

        <column xsi:type="bigint" name="id" unsigned="true"
                nullable="false" identity="true" comment="List ID"/>

        <column xsi:type="varchar" name="list_name" length="255"
                nullable="false" comment="List Name"/>

        <column xsi:type="int" name="customer_id" unsigned="true"
                nullable="false" comment="Customer ID"/>

        <column xsi:type="smallint" name="store_id" unsigned="true"
                nullable="false" comment="Store ID"/>

        <column xsi:type="timestamp" name="created_at"
                nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created At"/>

        <column xsi:type="timestamp" name="updated_at"
                nullable="false" default="CURRENT_TIMESTAMP"
                on_update="true" comment="Updated At"/>

        <!-- Primary -->
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>

        <!-- FK to customer -->
        <constraint xsi:type="foreign"
                    referenceId="FK_BROSOLUTIONS_LIST_CUSTOMER"
                    table="brosolutions_list"
                    column="customer_id"
                    referenceTable="customer_entity"
                    referenceColumn="entity_id"
                    onDelete="CASCADE"/>

        <!-- FK to store -->
        <constraint xsi:type="foreign"
                    referenceId="FK_BROSOLUTIONS_LIST_STORE"
                    table="brosolutions_list"
                    column="store_id"
                    referenceTable="store"
                    referenceColumn="store_id"
                    onDelete="CASCADE"/>

        <!-- Indexes -->
        <index referenceId="IDX_BROSOLUTIONS_LIST_CUSTOMER">
            <column name="customer_id"/>
        </index>

        <index referenceId="IDX_BROSOLUTIONS_LIST_STORE">
            <column name="store_id"/>
        </index>

        <index referenceId="IDX_BROSOLUTIONS_LIST_NAME">
            <column name="list_name"/>
        </index>

    </table>


    <table name="brosolutions_product_list"
           resource="default"
           engine="innodb"
           comment="BroSolutions Product List Items">

        <column xsi:type="bigint" name="id" unsigned="true"
                nullable="false" identity="true" comment="Item ID"/>

        <column xsi:type="bigint" name="list_id" unsigned="true"
                nullable="false" comment="List ID"/>

        <column xsi:type="bigint" name="product_id" unsigned="true"
                nullable="false" comment="Product ID"/>

        <column xsi:type="varchar" name="sku" length="64"
                nullable="false" comment="Product SKU"/>

        <!-- Self reference -->
        <column xsi:type="bigint" name="parent_id" unsigned="true"
                nullable="true" comment="Parent Item ID"/>

        <column xsi:type="decimal" name="qty" precision="12" scale="4"
                nullable="false" default="1.0000"
                comment="Product Quantity"/>

        <column xsi:type="timestamp" name="created_at"
                nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created At"/>

        <column xsi:type="timestamp" name="updated_at"
                nullable="false" default="CURRENT_TIMESTAMP"
                on_update="true" comment="Updated At"/>

        <!-- Primary -->
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>

        <!-- FK to list -->
        <constraint xsi:type="foreign"
                    referenceId="FK_BROSOLUTIONS_PRODUCT_LIST_LIST"
                    table="brosolutions_product_list"
                    column="list_id"
                    referenceTable="brosolutions_list"
                    referenceColumn="id"
                    onDelete="CASCADE"/>

        <!-- Self FK -->
        <constraint xsi:type="foreign"
                    referenceId="FK_BROSOLUTIONS_PRODUCT_LIST_PARENT"
                    table="brosolutions_product_list"
                    column="parent_id"
                    referenceTable="brosolutions_product_list"
                    referenceColumn="id"
                    onDelete="CASCADE"/>

        <!-- Indexes -->
        <index referenceId="IDX_BROSOLUTIONS_PRODUCT_LIST_LIST">
            <column name="list_id"/>
        </index>

        <index referenceId="IDX_BROSOLUTIONS_PRODUCT_LIST_PRODUCT">
            <column name="product_id"/>
        </index>

        <index referenceId="IDX_BROSOLUTIONS_PRODUCT_LIST_PARENT">
            <column name="parent_id"/>
        </index>

        <index referenceId="IDX_BROSOLUTIONS_PRODUCT_LIST_SKU">
            <column name="sku"/>
        </index>

    </table>
</schema>
