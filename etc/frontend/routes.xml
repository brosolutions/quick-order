<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:App/etc/routes.xsd">
	<router id="standard">
		<route frontName="quickorder" id="quickorder">
			<module name="BroSolutions_QuickOrder"/>
		</route>
        <route frontName="automatedorders" id="automatedorders">
            <module name="BroSolutions_QuickOrder"/>
        </route>
            <route id="customer" frontName="customer">
                <module name="BroSolutions_QuickOrder" before="Magento_Customer"/>
            </route>
	</router>
</config>
